# ==========================================
# KONFIGURASI ENVIRONMENT VARIABLE
# ==========================================

# 1. Supabase (Rekomendasi - Gratis & Mudah)
# Buat project di https://supabase.com
# Salin Project URL & Project API Key (anon public atau service_role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# 2. Alternatif: MongoDB Atlas Connection String
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/absensi_pkl?retryWrites=true&w=majority

# 3. Port lokal
PORT=3000

