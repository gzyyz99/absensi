# ==========================================
# KONFIGURASI ENVIRONMENT VARIABLE
# ==========================================

# 1. MongoDB Atlas Connection String
# Buat cluster gratis di: https://www.mongodb.com/atlas
# Salin connection string dari menu "Connect" -> "Drivers" -> "Node.js"
# Ganti <username> dan <password> sesuai akun database kamu.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/absensi_pkl?retryWrites=true&w=majority

# 2. Port untuk mode lokal (opsional, default 3000)
PORT=3000

